{
  "name": "e-commerce",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "dev:server": "npm --prefix server run dev",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev\"",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "start": "npm run dev:all",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.1.2",
    "oxlint": "^1.79.0",
    "prisma": "^8.0.0-rc.13",
    "vite": "^8.2.2"
  }
}
